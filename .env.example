# Supabase Postgres — copy to `.env` and fill in the real values.
# Both are needed: Prisma uses the pooled URL at runtime and the direct URL
# for migrations. Get them from Supabase → Project Settings → Database →
# Connection string → ORM → Prisma.
#
# If the password contains @ : / ? # & + then percent-encode it — those
# characters are reserved in a URI and will break the connection string.

# Transaction pooler (port 6543) — app runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
